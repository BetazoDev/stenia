{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "web-bridge",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "STENIA_DEPLOYMENT=server",
        "pnpm",
        "dev"
      ],
      "port": 3000
    }
  ]
}
