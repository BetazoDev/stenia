# Copia este archivo a .env.local y rellena los valores. Nunca subas secretos al repositorio.

# Base de datos (local: docker compose -f infra/docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://stenia:stenia@localhost:5432/stenia
# Conexiones del pool (con `pnpm db:dev` / PGlite usa 1)
DATABASE_POOL_MAX=5

# Better Auth (genera el secreto con: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos con rol admin (acceso a /settings/developer), separados por coma
ADMIN_EMAILS=

# 32 bytes en base64 para cifrar la API key del LLM (AES-256-GCM). Genera uno con: openssl rand -base64 32
ENCRYPTION_KEY=

# Opcionales: sobrescriben lo guardado en /settings/developer
AI_PROVIDER=
AI_API_KEY=

# Cloudflare R2 (acceso S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=stenia-private
R2_BUCKET_PUBLIC=stenia-public
R2_PUBLIC_BASE_URL=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# Autoriza las llamadas de tareas programadas a /api/cron/*
CRON_SECRET=

# Solo para el importador de alimentos (Fase 3)
USDA_FDC_API_KEY=

# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cuenta de prueba local (solo desarrollo; la usa el agente para registrar un usuario en localhost)
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
